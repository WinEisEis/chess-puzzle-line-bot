# ---- LINE (Developers Console → your channel → "Basic settings" tab,
#      or LINE Official Account Manager → Settings → Messaging API) ----
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Optional: long-lived token ("Messaging API" tab → Issue). Leave blank to use the
# Channel ID + secret above (the bot then makes its own 15-minute tokens automatically).
LINE_CHANNEL_ACCESS_TOKEN=

# Public HTTPS URL of this server, WITHOUT trailing slash.
# Local testing: the URL printed by cloudflared / ngrok, e.g. https://abcd-1234.ngrok-free.app
BASE_URL=https://your-tunnel-url.example

# ---- Commands ----
# The bot only answers messages starting with one of these (comma separated), e.g. "/chess endgame"
COMMAND_PREFIXES=/chess,/หมากรุก

# ---- Daily puzzle ----
DAILY_PUSH_ENABLED=true
DAILY_PUSH_TIME=08:00
TIMEZONE=Asia/Bangkok

# Any random string. Needed for POST /admin/push-daily and GET /admin/groups
ADMIN_KEY=change-me-to-something-random

# Optional: always push to these groups too (comma separated), e.g. Cxxxxxxxx,Cyyyyyyyy
GROUP_IDS=

# ---- Optional ----
# easiest | easier | normal | harder | hardest   (blank = harder)
PUZZLE_DIFFICULTY=harder
# Lichess personal API token (no scopes needed). Only if you hit rate limits.
LICHESS_TOKEN=
