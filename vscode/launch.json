{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run bot (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "jinja": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Preview a puzzle (no LINE needed)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/preview.py",
      "args": ["endgame"],
      "console": "integratedTerminal"
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal"
    }
  ]
}
